menu "Ping-Pong Configuration"

    config TX_POWER_DBM
        int "TX power (dBm)"
        range 2 22
        default 22
        help
            SX1262 output power. 22 dBm is the maximum; use this for range tests.

    config PONG_TIMEOUT_MS
        int "Pong wait timeout (ms)"
        range 500 30000
        default 7000
        help
            How long the sender waits for a PONG response before declaring timeout.
            At SF12/BW125 each packet takes ~1200 ms on air; RTT is ~2500 ms minimum.

    config PONG_DELAY_MAX_MS
        int "Max random PONG reply delay (ms)"
        range 0 500
        default 20
        help
            The responder waits a random 0..N ms before sending PONG.
            This prevents simultaneous replies when both devices hear the same packet.

    config BUTTON_GPIO
        int "USR button GPIO"
        default 0
        help
            GPIO of the user/boot button (active LOW). Default is GPIO0.

    config OLED_SDA_GPIO
        int "OLED SDA GPIO"
        default 17

    config OLED_SCL_GPIO
        int "OLED SCL GPIO"
        default 18

    config OLED_VEXT_GPIO
        int "OLED VEXT GPIO (-1 to skip)"
        default 36
        help
            Set LOW to power the OLED. Use -1 if always powered.

    config OLED_RST_GPIO
        int "OLED RESET GPIO (-1 to skip)"
        default 21
        help
            Toggle this line during init if the OLED has a dedicated reset pin.

    config OLED_CONTRAST
        int "OLED contrast"
        range 0 255
        default 255
        help
            SSD1306/SSD1315 contrast value. Higher values make the display brighter.

    config DISPLAY_SLEEP_S
        int "Display sleep timeout (seconds)"
        range 10 3600
        default 300
        help
            Seconds of inactivity (no button press, no packet) before the OLED
            is powered off. Press the USR button once to wake it (without sending
            a PING). Set to 3600 to effectively disable auto-sleep.

    config FEM_VCC_GPIO
        int "FEM VCC power-enable GPIO"
        default 7
        help
            GPIO that enables power to the front-end module (FEM).
            Heltec V4: GPIO7 powers the GC1109 / KCT8103L LDO.
            Must be driven HIGH before using the radio.

    config FEM_CSD_GPIO
        int "FEM CSD chip-enable GPIO"
        default 2
        help
            GPIO connected to the FEM CSD (chip shutdown) pin.
            Active HIGH: must be HIGH for the FEM PA and LNA to operate.
            Heltec V4.2 (GC1109) and V4.3 (KCT8103L): both use GPIO2.

endmenu
