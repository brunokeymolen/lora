{
  "name": "Flutter (LoRa Text App)",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "upgradePackages": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "editor.formatOnSave": true,
        "[dart]": {
          "editor.defaultFormatter": "Dart-Code.dart-code"
        }
      }
    }
  },
  "postCreateCommand": "cd src && flutter pub get",
  "remoteUser": "root",
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind,consistency=cached"
  ],
  "runArgs": ["--privileged"]
}
